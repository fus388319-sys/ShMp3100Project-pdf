<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ShMp3100 Tool - PDF Maker App</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --primary: #6C3CE1;
    --primary-light: #8B5CF6;
    --primary-dark: #5B21B6;
    --accent: #A78BFA;
    --autumn-red: #C0392B;
    --autumn-orange: #E67E22;
    --autumn-gold: #F39C12;
    --autumn-dark: #1a0a00;
    --autumn-warm: #2d1808;
    --text-dark: #1E1B4B;
    --text-mid: #4C1D95;
    --shadow: 0 20px 60px rgba(108, 60, 225, 0.15);
    --shadow-sm: 0 4px 15px rgba(108, 60, 225, 0.1);
  }

  body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
    color: var(--text-dark);
    background: #0a0505;
  }

  /* Autumn Wallpaper Background */
  .autumn-wallpaper {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 0;
    background: 
      radial-gradient(ellipse at 20% 20%, rgba(192, 57, 43, 0.4) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 10%, rgba(230, 126, 34, 0.35) 0%, transparent 45%),
      radial-gradient(ellipse at 50% 50%, rgba(243, 156, 18, 0.2) 0%, transparent 60%),
      radial-gradient(ellipse at 10% 80%, rgba(192, 57, 43, 0.3) 0%, transparent 50%),
      radial-gradient(ellipse at 90% 70%, rgba(211, 84, 0, 0.25) 0%, transparent 45%),
      radial-gradient(ellipse at 50% 100%, rgba(160, 40, 10, 0.3) 0%, transparent 50%),
      linear-gradient(180deg, #1a0800 0%, #2d1208 20%, #3d1a0a 40%, #2a1005 60%, #1a0800 80%, #0d0400 100%);
  }

  .autumn-wallpaper::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: 
      radial-gradient(circle at 15% 15%, rgba(255, 165, 0, 0.15) 0%, transparent 3%),
      radial-gradient(circle at 25% 10%, rgba(255, 100, 0, 0.12) 0%, transparent 2.5%),
      radial-gradient(circle at 35% 18%, rgba(255, 200, 50, 0.1) 0%, transparent 2%),
      radial-gradient(circle at 70% 12%, rgba(255, 140, 0, 0.13) 0%, transparent 3%),
      radial-gradient(circle at 80% 8%, rgba(255, 80, 0, 0.11) 0%, transparent 2%),
      radial-gradient(circle at 60% 20%, rgba(255, 180, 50, 0.09) 0%, transparent 2.5%),
      radial-gradient(circle at 45% 5%, rgba(255, 120, 0, 0.14) 0%, transparent 2%),
      radial-gradient(circle at 90% 15%, rgba(255, 160, 30, 0.1) 0%, transparent 2.5%);
    animation: sparkle 4s ease-in-out infinite alternate;
  }

  @keyframes sparkle {
    0% { opacity: 0.6; }
    100% { opacity: 1; }
  }

  .autumn-wallpaper::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 5 C35 15, 45 15, 50 25 C55 35, 45 45, 30 55 C15 45, 5 35, 10 25 C15 15, 25 15, 30 5Z' fill='none' stroke='rgba(255,100,0,0.03)' stroke-width='0.5'/%3E%3C/svg%3E");
    opacity: 0.5;
  }

  /* Floating autumn leaves */
  .falling-leaves {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .leaf {
    position: absolute;
    top: -50px;
    font-size: 24px;
    opacity: 0.4;
    animation: fallLeaf linear infinite;
  }

  .leaf:nth-child(1) { left: 10%; animation-duration: 15s; animation-delay: 0s; font-size: 20px; }
  .leaf:nth-child(2) { left: 25%; animation-duration: 18s; animation-delay: -3s; font-size: 16px; }
  .leaf:nth-child(3) { left: 40%; animation-duration: 12s; animation-delay: -7s; font-size: 22px; }
  .leaf:nth-child(4) { left: 55%; animation-duration: 20s; animation-delay: -5s; font-size: 18px; }
  .leaf:nth-child(5) { left: 70%; animation-duration: 16s; animation-delay: -10s; font-size: 24px; }
  .leaf:nth-child(6) { left: 85%; animation-duration: 14s; animation-delay: -2s; font-size: 15px; }
  .leaf:nth-child(7) { left: 5%; animation-duration: 22s; animation-delay: -8s; font-size: 19px; }
  .leaf:nth-child(8) { left: 50%; animation-duration: 17s; animation-delay: -12s; font-size: 21px; }

  @keyframes fallLeaf {
    0% { transform: translateY(-50px) rotate(0deg) translateX(0); opacity: 0; }
    10% { opacity: 0.5; }
    90% { opacity: 0.3; }
    100% { transform: translateY(100vh) rotate(720deg) translateX(100px); opacity: 0; }
  }

  /* Watermark */
  .watermark {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 9999;
    font-size: 11px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.25);
    letter-spacing: 1px;
    pointer-events: none;
    text-shadow: 0 1px 3px rgba(0,0,0,0.3);
    background: rgba(0,0,0,0.15);
    padding: 6px 14px;
    border-radius: 8px;
    backdrop-filter: blur(5px);
    border: 1px solid rgba(255,255,255,0.08);
  }

  .watermark-corner {
    position: fixed;
    top: 20px;
    left: 20px;
    z-index: 9999;
    font-size: 10px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.2);
    letter-spacing: 2px;
    pointer-events: none;
    text-transform: uppercase;
  }

  /* Navbar */
  .navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    background: rgba(26, 10, 5, 0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 165, 0, 0.15);
    padding: 12px 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 0.3s ease;
  }

  .navbar.scrolled {
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
    background: rgba(26, 10, 5, 0.95);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .logo-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .logo-icon svg {
    width: 40px;
    height: 40px;
  }

  .logo-text {
    font-size: 22px;
    font-weight: 800;
    color: white;
  }

  .logo-text span {
    background: linear-gradient(135deg, #F39C12, #E67E22);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-link {
    padding: 8px 18px;
    border-radius: 10px;
    text-decoration: none;
    color: rgba(255,255,255,0.7);
    font-weight: 600;
    font-size: 14px;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .nav-link:hover, .nav-link.active {
    background: rgba(243, 156, 18, 0.15);
    color: #F39C12;
  }

  .nav-btn {
    padding: 10px 24px;
    background: linear-gradient(135deg, #E67E22, #F39C12);
    color: white;
    border: none;
    border-radius: 12px;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(230, 126, 34, 0.4);
  }

  .nav-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(230, 126, 34, 0.5);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 5px;
  }

  .hamburger span {
    width: 24px;
    height: 2.5px;
    background: white;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  /* Hero Section */
  .hero {
    padding: 140px 30px 80px;
    text-align: center;
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-logo-large {
    width: 120px;
    height: 120px;
    margin: 0 auto 30px;
    animation: logoFloat 3s ease-in-out infinite;
    filter: drop-shadow(0 10px 30px rgba(243, 156, 18, 0.3));
  }

  @keyframes logoFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(243, 156, 18, 0.15);
    color: #F39C12;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 24px;
    border: 1px solid rgba(243, 156, 18, 0.2);
    animation: fadeInUp 0.6s ease;
  }

  .hero-badge .dot {
    width: 8px;
    height: 8px;
    background: #F39C12;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }

  .hero h1 {
    font-size: 52px;
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: 20px;
    color: white;
    animation: fadeInUp 0.6s ease 0.1s both;
  }

  .hero h1 .highlight {
    background: linear-gradient(135deg, #F39C12, #E67E22, #C0392B);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero p {
    font-size: 18px;
    color: rgba(255,255,255,0.6);
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    animation: fadeInUp 0.6s ease 0.2s both;
  }

  .hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    margin-bottom: 50px;
    animation: fadeInUp 0.6s ease 0.3s both;
    flex-wrap: wrap;
  }

  .btn-primary {
    padding: 16px 36px;
    background: linear-gradient(135deg, #E67E22, #F39C12);
    color: white;
    border: none;
    border-radius: 16px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 8px 30px rgba(230, 126, 34, 0.4);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(230, 126, 34, 0.5);
  }

  .btn-secondary {
    padding: 16px 36px;
    background: rgba(255,255,255,0.1);
    color: white;
    border: 2px solid rgba(255,255,255,0.2);
    border-radius: 16px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 10px;
    backdrop-filter: blur(10px);
  }

  .btn-secondary:hover {
    border-color: #F39C12;
    background: rgba(243, 156, 18, 0.1);
    transform: translateY(-3px);
  }

  .hero-stats {
    display: flex;
    gap: 50px;
    justify-content: center;
    animation: fadeInUp 0.6s ease 0.4s both;
    flex-wrap: wrap;
  }

  .stat {
    text-align: center;
  }

  .stat-number {
    font-size: 32px;
    font-weight: 900;
    background: linear-gradient(135deg, #F39C12, #E67E22);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stat-label {
    font-size: 13px;
    color: rgba(255,255,255,0.5);
    font-weight: 600;
    margin-top: 4px;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Features Section */
  .features-section {
    padding: 80px 30px;
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .section-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .section-header h2 {
    font-size: 40px;
    font-weight: 900;
    margin-bottom: 16px;
    color: white;
  }

  .section-header h2 .highlight {
    background: linear-gradient(135deg, #F39C12, #E67E22);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-header p {
    font-size: 16px;
    color: rgba(255,255,255,0.5);
    max-width: 500px;
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .feature-card {
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(20px);
    border-radius: 24px;
    padding: 32px;
    transition: all 0.4s ease;
    border: 1px solid rgba(255,255,255,0.08);
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(135deg, #F39C12, #E67E22, #C0392B);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .feature-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(230, 126, 34, 0.15);
    border-color: rgba(243, 156, 18, 0.3);
    background: rgba(255,255,255,0.08);
  }

  .feature-card:hover::before {
    opacity: 1;
  }

  .feature-icon-box {
    width: 60px;
    height: 60px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    margin-bottom: 20px;
  }

  .feature-icon-box.orange { background: rgba(243, 156, 18, 0.15); }
  .feature-icon-box.red { background: rgba(192, 57, 43, 0.15); }
  .feature-icon-box.green { background: rgba(39, 174, 96, 0.15); }
  .feature-icon-box.blue { background: rgba(52, 152, 219, 0.15); }
  .feature-icon-box.purple { background: rgba(155, 89, 182, 0.15); }
  .feature-icon-box.gold { background: rgba(241, 196, 15, 0.15); }
  .feature-icon-box.teal { background: rgba(26, 188, 156, 0.15); }
  .feature-icon-box.pink { background: rgba(232, 67, 147, 0.15); }

  .feature-card h3 {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 10px;
    color: white;
  }

  .feature-card p {
    font-size: 14px;
    color: rgba(255,255,255,0.5);
    line-height: 1.7;
  }

  .feature-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background: linear-gradient(135deg, #F39C12, #E67E22);
    color: white;
    font-size: 10px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
  }

  /* Tools Section */
  .tools-section {
    padding: 80px 30px;
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
  }

  .tool-card {
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    padding: 24px 16px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 1.5px solid rgba(255,255,255,0.08);
  }

  .tool-card:hover {
    border-color: rgba(243, 156, 18, 0.4);
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(230, 126, 34, 0.15);
    background: rgba(255,255,255,0.08);
  }

  .tool-card-icon {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px;
    font-size: 24px;
  }

  .tool-card h4 {
    font-size: 13px;
    font-weight: 700;
    color: white;
    margin-bottom: 4px;
  }

  .tool-card p {
    font-size: 11px;
    color: rgba(255,255,255,0.4);
  }

  /* Upload Section */
  .upload-section {
    padding: 80px 30px;
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .upload-area {
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(20px);
    border: 2px dashed rgba(243, 156, 18, 0.3);
    border-radius: 24px;
    padding: 60px 40px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .upload-area:hover {
    border-color: #F39C12;
    background: rgba(243, 156, 18, 0.05);
  }

  .upload-area.dragover {
    border-color: #F39C12;
    background: rgba(243, 156, 18, 0.1);
    transform: scale(1.02);
  }

  .upload-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #E67E22, #F39C12);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    font-size: 36px;
    color: white;
    box-shadow: 0 10px 30px rgba(230, 126, 34, 0.4);
  }

  .upload-area h3 {
    font-size: 22px;
    font-weight: 800;
    color: white;
    margin-bottom: 8px;
  }

  .upload-area p {
    font-size: 14px;
    color: rgba(255,255,255,0.5);
    margin-bottom: 24px;
  }

  .upload-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 0;
  }

  .upload-btn {
    padding: 14px 32px;
    background: linear-gradient(135deg, #E67E22, #F39C12);
    color: white;
    border: none;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 6px 20px rgba(230, 126, 34, 0.4);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .upload-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(230, 126, 34, 0.5);
  }

  .camera-btn {
    padding: 14px 32px;
    background: linear-gradient(135deg, #27AE60, #2ECC71);
    color: white;
    border: none;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 6px 20px rgba(39, 174, 96, 0.4);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .camera-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(39, 174, 96, 0.5);
  }

  .file-list {
    margin-top: 24px;
  }

  .file-list-item {
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(20px);
    border-radius: 16px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
    border: 1px solid rgba(255,255,255,0.08);
    animation: slideIn 0.3s ease;
  }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .file-list-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: white;
    font-weight: 800;
  }

  .file-list-info { flex: 1; }

  .file-list-name {
    font-size: 14px;
    font-weight: 700;
    color: white;
  }

  .file-list-size {
    font-size: 12px;
    color: rgba(255,255,255,0.4);
  }

  .file-list-actions { display: flex; gap: 8px; }

  .file-action-btn {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    transition: all 0.3s ease;
  }

  .file-action-btn.download {
    background: rgba(243, 156, 18, 0.15);
    color: #F39C12;
  }

  .file-action-btn.delete {
    background: rgba(231, 76, 60, 0.15);
    color: #E74C3C;
  }

  .file-action-btn:hover { transform: scale(1.1); }

  .progress-bar {
    width: 100%;
    height: 4px;
    background: rgba(255,255,255,0.1);
    border-radius: 2px;
    margin-top: 8px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(135deg, #F39C12, #E67E22);
    border-radius: 2px;
    transition: width 0.5s ease;
    width: 0%;
  }

  /* Camera Modal */
  .camera-modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.9);
    backdrop-filter: blur(10px);
    z-index: 3000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .camera-modal-overlay.show { display: flex; }

  .camera-modal {
    background: rgba(30, 15, 8, 0.95);
    backdrop-filter: blur(30px);
    border-radius: 24px;
    padding: 30px;
    max-width: 600px;
    width: 100%;
